{
  "name": "acme-ds-example",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ../../packages/girih/dist/cli.js check",
    "generate": "node ../../packages/girih/dist/cli.js generate css",
    "generate:check": "node ../../packages/girih/dist/cli.js generate css --check",
    "generate:react": "node ../../packages/girih/dist/cli.js generate react",
    "demo:react": "node ../../packages/girih/dist/cli.js generate react && esbuild demo/react/main.tsx --bundle --outfile=demo/react/bundle.js --jsx=automatic"
  },
  "devDependencies": {
    "@faravahar/girih": "workspace:*",
    "@faravahar/girih-react-runtime": "workspace:*",
    "@types/react": "^19.2.17",
    "esbuild": "^0.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@base-ui-components/react": "1.0.0-rc.0"
  }
}
