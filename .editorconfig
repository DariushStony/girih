root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.md]
# Trailing whitespace is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# Emitted by girih and hashed in .ds/manifest.json — reformatting these is drift.
[{docs/md/**,docs/data/**,examples/*/.ds/**,examples/*/packages/**,examples/*/styles/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
