node_modules/
dist/
.turbo/
*.log
.DS_Store
.vscode/

# `pnpm publish` refuses to run on a dirty tree, so stray pack output must never
# be able to make it dirty. Tarballs belong in a temp dir — see scripts/verify-tarballs.mjs.
*.tgz

# generated output inside example workspaces (manifest + IR under .ds/ are committed)
examples/*/packages/
examples/*/.ds/cache/
examples/*/.ds/baked/
examples/*/demo/generated/

# react demo bundles
examples/*/demo/react/bundle.js*

# e2e scratch workspaces
e2e/.tmp/

graphify-out/
