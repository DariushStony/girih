{
  "name": "@faravahar/girih-generator-react",
  "version": "0.1.0",
  "description": "girih React generator: ComponentIR + templates → React package source",
  "keywords": [
    "girih",
    "design-system",
    "design-tokens",
    "react",
    "codegen",
    "component-generator"
  ],
  "homepage": "https://github.com/DariushStony/girih#readme",
  "bugs": "https://github.com/DariushStony/girih/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DariushStony/girih.git",
    "directory": "packages/generator-react"
  },
  "author": "Dariush Hadipour",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup src/index.ts --format esm --sourcemap --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@faravahar/girih-core": "workspace:*",
    "@faravahar/girih-spec": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
