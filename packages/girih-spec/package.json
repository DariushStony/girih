{
  "name": "@faravahar/girih-spec",
  "version": "0.1.0",
  "description": "girih component contracts: defineSpec, validation against brand token graphs, canonical ComponentIR",
  "keywords": [
    "girih",
    "design-system",
    "design-tokens",
    "component-contract",
    "defineSpec",
    "ir"
  ],
  "homepage": "https://github.com/DariushStony/girih#readme",
  "bugs": "https://github.com/DariushStony/girih/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DariushStony/girih.git",
    "directory": "packages/girih-spec"
  },
  "author": "Dariush Hadipour",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup src/index.ts --format esm --sourcemap --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@faravahar/girih-core": "workspace:*",
    "@faravahar/girih-tokens": "workspace:*",
    "jiti": "^2.7.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
