{
  "name": "@faravahar/girih",
  "version": "0.1.0",
  "description": "girih CLI — compile a multi-brand design system from tokens and component contracts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "girih": "./dist/cli.js",
    "ds": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@faravahar/girih-core": "workspace:*",
    "@faravahar/girih-generator-css": "workspace:*",
    "@faravahar/girih-tokens": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "@faravahar/girih-spec": "workspace:*",
    "@faravahar/girih-generator-react": "workspace:*",
    "typescript": "^5.9.3",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1"
  }
}
