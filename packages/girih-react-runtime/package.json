{
  "name": "@faravahar/girih-react-runtime",
  "version": "0.1.0",
  "description": "girih runtime for generated code — BrandProvider, useBrand, cx (createVariant lands in M5)",
  "keywords": [
    "girih",
    "design-system",
    "design-tokens",
    "react",
    "brand-provider",
    "theming"
  ],
  "homepage": "https://github.com/DariushStony/girih#readme",
  "bugs": "https://github.com/DariushStony/girih/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DariushStony/girih.git",
    "directory": "packages/girih-react-runtime"
  },
  "author": "Dariush Hadipour",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup src/index.tsx --format esm --sourcemap --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
