{
  "name": "@faravahar/girih",
  "version": "0.4.0",
  "description": "girih CLI — compile a multi-brand design system from tokens and component contracts",
  "keywords": [
    "girih",
    "design-system",
    "design-tokens",
    "cli",
    "dtcg",
    "multi-brand",
    "codegen",
    "theming"
  ],
  "homepage": "https://github.com/DariushStony/girih#readme",
  "bugs": "https://github.com/DariushStony/girih/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DariushStony/girih.git",
    "directory": "packages/girih"
  },
  "author": "Dariush Hadipour",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "bin": {
    "girih": "./dist/cli.js",
    "ds": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup src/cli.ts src/index.ts src/scaffold.ts --format esm --sourcemap --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@faravahar/girih-core": "workspace:*",
    "@faravahar/girih-generator-css": "workspace:*",
    "@faravahar/girih-tokens": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "@faravahar/girih-spec": "workspace:*",
    "@faravahar/girih-generator-react": "workspace:*",
    "typescript": "^6.0.3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1"
  }
}
