{
  "name": "@faravahar/girih-core",
  "version": "0.4.1",
  "description": "girih shared kernel: workspace config, diagnostics, emitted-file model",
  "keywords": [
    "girih",
    "design-system",
    "design-tokens",
    "diagnostics",
    "workspace-config"
  ],
  "homepage": "https://github.com/DariushStony/girih#readme",
  "bugs": "https://github.com/DariushStony/girih/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DariushStony/girih.git",
    "directory": "packages/girih-core"
  },
  "author": "Dariush Hadipour",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup src/index.ts --format esm --sourcemap --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
