{
  "name": "@girih/generator-css",
  "version": "0.1.0",
  "description": "girih CSS generator: token graphs in, multi-brand CSS custom properties + TokenPath types out",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@girih/core": "workspace:*",
    "@girih/tokens": "workspace:*",
    "style-dictionary": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
