{
  "name": "girih-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run packages",
    "test:e2e": "vitest run e2e",
    "example:check": "pnpm --filter acme-ds-example exec girih check",
    "example:drift": "pnpm --filter acme-ds-example exec girih generate react --check",
    "docs:generate": "pnpm build && pnpm --filter acme-ds-example exec girih generate react && pnpm docs:data && pnpm docs:build",
    "docs:data": "node docs/scripts/extract-diagnostics.mjs && node docs/scripts/extract-tokens.mjs",
    "docs:build": "node docs/scripts/build-docs.mjs",
    "docs:verify": "node docs/scripts/verify-docs.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm example:check && pnpm example:drift",
    "pack:verify": "node scripts/verify-tarballs.mjs",
    "release": "pnpm verify && pnpm pack:verify && pnpm -r --filter \"./packages/*\" publish --access public --publish-branch main",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
